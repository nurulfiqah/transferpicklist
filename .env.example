# Copy this file to .env (same folder) and fill in the real values.
# .env is git-ignored — never commit real passwords.
# Read by transferpicklist_env.php (PHP) and hyper/db_config.py (Python syncs).

# Tableau API login (all syncs + outlet tracker)
TABLEAU_API_USER=
TABLEAU_API_PASS=

# Secret for scheduled / URL-triggered runs (?secret=...): sync pages,
# autopublish. Must match the URLs in Task Scheduler.
TPL_SYNC_SECRET=

# Production database for the Python syncs (used when NOT running from C:\laragon)
DB_PROD_HOST=localhost
DB_PROD_PORT=2215
DB_PROD_USER=root
DB_PROD_PASS=
DB_PROD_NAME=odb

# Local Laragon database (optional — these are the defaults)
# DB_LOCAL_HOST=localhost
# DB_LOCAL_PORT=3306
# DB_LOCAL_USER=root
# DB_LOCAL_PASS=
# DB_LOCAL_NAME=odb
